package com.example.lab3javafx;

import javafx.scene.paint.Color;

public class RandomLine {

    double x;
    double length;
    Color color;

    public RandomLine(double x) { 

        this.x = x;

        length = 50 + Math.random() * 350;

        color = Color.color(
                Math.random(),
                Math.random(),
                Math.random()
        );
    }

    public double getX() {
        return x;
    }

    public double getLength() {
        return length;
    }

    public Color getColor() {
        return color;
    }
}
